# Server
PORT=5000
NODE_ENV=development

# MongoDB
# Local dev (docker-compose):        mongodb://mongo:27017/mernapp
# Kubernetes (Service name "mongodb"): mongodb://mongodb:27017/mernapp
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DB=mernapp
MONGO_USER=
MONGO_PASSWORD=

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=1d

# CORS - comma separated list of allowed origins
CORS_ORIGIN=http://localhost:5173
